    "gh-pages": "^6.3.0",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "homepage": "https://mballesterdev.github.io/ecommerce-product-page-FM/"
